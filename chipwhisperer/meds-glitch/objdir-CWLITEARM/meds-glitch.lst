  46:meds-glitch.c **** uint8_t get_pt(uint8_t* pt, uint8_t len)
  47:meds-glitch.c **** {
  48:meds-glitch.c **** 	/**********************************
  49:meds-glitch.c **** 	* Start user-specific code here. */
  50:meds-glitch.c **** 	trigger_high();
  51:meds-glitch.c **** 
  52:meds-glitch.c **** 	//16 hex bytes held in 'pt' were sent
  53:meds-glitch.c **** 	//from the computer. Store your response
  54:meds-glitch.c **** 	//back into 'pt', which will send 16 bytes
  55:meds-glitch.c **** 	//back to computer. Can ignore of course if
  56:meds-glitch.c **** 	//not needed
  57:meds-glitch.c **** 
  58:meds-glitch.c **** 	trigger_low();
  59:meds-glitch.c **** 	/* End user-specific code here. *
  60:meds-glitch.c **** 	********************************/
  61:meds-glitch.c **** 	simpleserial_put('r', 16, pt);
  62:meds-glitch.c **** 	return 0x00;
  63:meds-glitch.c **** }
